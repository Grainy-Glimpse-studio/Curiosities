{
  "framework": "vite",
  "installCommand": "cd projects/twin-peaks-recorder && npm install",
  "buildCommand": "cd projects/twin-peaks-recorder && npm run build",
  "outputDirectory": "projects/twin-peaks-recorder/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
